{
  "expo": {
    "name": "Pets",
    "slug": "Pets",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./front/assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./front/assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.workflowfatecitaquera.Pets",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./front/assets/icon.png",
        "backgroundImage": "./front/assets/icon.png",
        "monochromeImage": "./front/assets/icon.png"
      },
      "package": "com.workflowfatecitaquera.Pets"
    },
    "web": {
      "favicon": "./front/assets/icon.png"
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "e884e9a2-2217-4c74-9f1d-15a55e864b34"
      }
    }
  }
}
